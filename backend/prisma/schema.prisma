generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
}

model Answers {
  ID         Int       @id(map: "PK__Answers__3214EC2754FC3142") @default(autoincrement())
  QuestionID Int
  AnswerEN   String    @db.NVarChar(300)
  AnswerDE   String    @db.NVarChar(300)
  IsCorrect  Boolean
  Questions  Questions @relation(fields: [QuestionID], references: [ID], onDelete: Cascade, onUpdate: NoAction, map: "Fk_Answers_Questions")
}

model Customer {
  ID          Int       @id(map: "PK__Customer__3214EC27CB657927") @default(autoincrement())
  Name        String?   @db.NVarChar(50)
  PhoneNumber String?   @db.NVarChar(50)
  Service     Service[]
}

model Device {
  ID                   Int         @id(map: "PK__Device__3214EC27C2EA0DCA") @default(autoincrement())
  TypeID               Int?
  RackID               Int?
  InternalID           String?     @db.NVarChar(50)
  PositionFrom         Int?
  PositionTo           Int?
  ElectricityConnected Boolean?    @default(false, map: "DF__Device__Electric__5165187F")
  TORConnected         Boolean?    @default(false, map: "DF__Device__TORConne__52593CB8")
  DeviceType           DeviceType? @relation(fields: [TypeID], references: [ID], onDelete: Cascade, onUpdate: NoAction, map: "FK_DeviceType_Device")
  Rack                 Rack?       @relation(fields: [RackID], references: [ID], onDelete: Cascade, onUpdate: NoAction, map: "FK_Rack_Device")
  VM                   VM[]
}

model DeviceType {
  ID           Int      @id(map: "PK__DeviceTy__3214EC2747ECF2C0") @default(autoincrement())
  TypeName     String?  @db.NVarChar(100)
  Manufacturer String?  @db.NVarChar(50)
  Usage        String?  @db.NVarChar(100)
  Device       Device[]
}

model Questions {
  ID         Int       @id(map: "PK__Question__3214EC27B73965ED") @default(autoincrement())
  QuestionEN String    @db.NVarChar(500)
  QuestionDE String    @db.NVarChar(500)
  CreatedAt  DateTime? @default(now(), map: "DF__Questions__Creat__74AE54BC") @db.DateTime
  IsActive   Boolean   @default(false, map: "DF__Questions__IsAct__787EE5A0")
  Answers    Answers[]
}

model Rack {
  ID        Int       @id(map: "PK_Rack")
  UnitsSize Int?
  HeightCm  Decimal?  @db.Decimal(5, 2)
  Device    Device[]
  Equipment Equipment @relation(fields: [ID], references: [ID], onDelete: Cascade, onUpdate: NoAction, map: "FK_Rack_Equipment")
}

model Room {
  ID        Int         @id(map: "PK__Room__3214EC278D3F5492") @default(autoincrement())
  Area      Int?
  Capacity  Int?
  HeightCm  Decimal?    @db.Decimal(8, 2)
  Equipment Equipment[]
}

model Service {
  ID         Int       @id(map: "PK__Service__3214EC27DE6E787B") @default(autoincrement())
  CustomerID Int?
  Name       String?   @db.NVarChar(100)
  Customer   Customer? @relation(fields: [CustomerID], references: [ID], onDelete: Cascade, onUpdate: NoAction, map: "FK_CustomerID_Service")
  VM         VM[]
}

model Users {
  Id        Int       @id(map: "PK__Users__3214EC07664EB737") @default(autoincrement())
  Username  String    @unique(map: "UQ__Users__A9D1053411B1AFA5") @db.NVarChar(255)
  Password  String    @db.NVarChar(255)
  Role      String    @db.NVarChar(20)
  CreatedAt DateTime? @default(now(), map: "DF__Users__CreatedAt__71D1E811")
}

model VM {
  ID        Int      @id(map: "PK__VM__3214EC277FF317EB") @default(autoincrement())
  ServiceID Int?
  DeviceID  Int?
  Name      String?  @db.NVarChar(50)
  Device    Device?  @relation(fields: [DeviceID], references: [ID], onDelete: Cascade, onUpdate: NoAction, map: "FK_VM_DeviceID")
  Service   Service? @relation(fields: [ServiceID], references: [ID], onDelete: Cascade, onUpdate: NoAction, map: "FK_VM_ServiceID")
}

model UPS {
  ID        Int       @id(map: "PK_UPS_Equipment")
  UnitsSize Int?
  HeightCm  Decimal?  @db.Decimal(5, 2)
  Equipment Equipment @relation(fields: [ID], references: [ID], onDelete: Cascade, onUpdate: NoAction, map: "FK_UPS_Equipment")
}

model Connection {
  ID              Int            @id(map: "PK_Connection") @default(autoincrement())
  FromEquipmentID Int
  ToEquipmentID   Int
  TypeID          Int
  FromEquipment   Equipment      @relation("CableFrom", fields: [FromEquipmentID], references: [ID], onUpdate: NoAction, map: "FK_Connection_FromEquipment")
  ToEquipment     Equipment      @relation("CableTo", fields: [ToEquipmentID], references: [ID], onUpdate: NoAction, map: "FK_Connection_ToEquipment")
  ConnectionType  ConnectionType @relation(fields: [TypeID], references: [ID], onUpdate: NoAction, map: "FK_Connection_Type")

  @@unique([FromEquipmentID, ToEquipmentID, TypeID], map: "UQ_Connection")
  @@index([ToEquipmentID], map: "IX_Connection_ToEquipmentID")
}

model ConnectionType {
  ID         Int          @id(map: "PK_ConnectionType") @default(autoincrement())
  NameEN     String       @unique(map: "UQ_ConnectionType_NameEN") @db.NVarChar(50)
  NameDE     String       @db.NVarChar(50)
  Color      String       @db.NVarChar(20)
  Connection Connection[]
}

model Equipment {
  ID         Int          @id(map: "PK_Equipment") @default(autoincrement())
  RoomID     Int
  Type       String       @db.NVarChar(10) // 'rack' | 'ups' | 'pdu'
  CablesFrom Connection[] @relation("CableFrom")
  CablesTo   Connection[] @relation("CableTo")
  Room       Room         @relation(fields: [RoomID], references: [ID], onDelete: Cascade, onUpdate: NoAction, map: "FK_Equipment_Room")
  PDU        PDU?
  Rack       Rack?
  UPS        UPS?

  @@index([RoomID], map: "IX_Equipment_RoomID")
}

model PDU {
  ID          Int       @id(map: "PK_PDU")
  OutletCount Int?
  Equipment   Equipment @relation(fields: [ID], references: [ID], onDelete: Cascade, onUpdate: NoAction, map: "FK_PDU_Equipment")
}
